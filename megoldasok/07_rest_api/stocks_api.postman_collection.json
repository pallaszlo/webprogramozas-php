              ],
              "path": [
                "stocks",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"ticker\": \"AAPL\",\n    \"company_name\": \"Apple Inc.\",\n    \"sector_id\": 1,\n    \"price\": 195.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
