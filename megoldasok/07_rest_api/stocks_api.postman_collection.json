                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/stocks/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stocks",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"price\": 199.99\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Törlés (204)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/stocks/5",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stocks",
                "5"
              ]
            }
          }
        }
      ]
    },
    {
