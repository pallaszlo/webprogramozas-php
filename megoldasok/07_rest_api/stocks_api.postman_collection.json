{
  "info": {
    "name": "Stocks API (7. fejezet, 6. feladat)",
    "description": "A részvénykatalógus API összes végpontja. Előbb a Bejelentkezés kérést kell elküldeni: a válaszban kapott tokent a gyűjtemény a {{token}} változóba menti, a módosító kérések ezt küldik az Authorization fejlécben.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8081/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Hitelesítés",
      "item": [
        {
          "name": "Bejelentkezés",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "if (body.data && body.data.token) {",
                  "    pm.collectionVariables.set('token', body.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Bejelentkezés hibás jelszóval (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"rossz\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Részvények",
      "item": [
        {
          "name": "Lista",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/stocks",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stocks"
              ]
            }
          }
        },
        {
          "name": "Lista szűréssel, rendezéssel, lapozással",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/stocks?sector=1&sort=price_desc&page=1&limit=2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stocks"
              ],
              "query": [
                {
                  "key": "sector",
                  "value": "1"
                },
                {
                  "key": "sort",
                  "value": "price_desc"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "2"
                }
              ]
            }
          }
        },
        {
          "name": "Egy részvény",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/stocks/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stocks",
                "1"
              ]
            }
          }
        },
        {
          "name": "Nem létező részvény (404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/stocks/999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stocks",
                "999"
              ]
            }
          }
        },
        {
          "name": "Új részvény",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/stocks",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stocks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"ticker\": \"NVDA\",\n    \"company_name\": \"NVIDIA Corp.\",\n    \"sector_id\": 1,\n    \"price\": 875.4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Új részvény token nélkül (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/stocks",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stocks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"ticker\": \"NVDA\",\n    \"company_name\": \"NVIDIA Corp.\",\n    \"price\": 875.4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Új részvény hibás adatokkal (422)",
          "request": {
            "method": "POST",
            "header": [
