                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/stocks",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stocks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"ticker\": \"\",\n    \"company_name\": \"\",\n    \"price\": -5\n}",
              "options": {
