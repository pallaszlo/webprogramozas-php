{
    "name": "myvendor/calendar-app",
    "description": "Composer feladatok megoldása – Carbon, PSR-4, var-dumper, scripts, PHPMailer, .env",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "nesbot/carbon": "^3.0",
        "vlucas/phpdotenv": "^5.0",
        "phpmailer/phpmailer": "^6.0"
    },
    "require-dev": {
        "symfony/var-dumper": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8000 -t public"
    }
}
